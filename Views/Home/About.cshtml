@{
    ViewData["Title"] = "About Us";
}

<section class="page-header">
    <div class="container">
        <nav class="breadcrumb-nav">
            <a asp-action="Index">Home</a>
            <span>/</span>
            <span>About Us</span>
        </nav>
        <h1>About Us</h1>
        <p>Aloha spirit first — tropical casino hospitality rooted in Hawaiian tradition.</p>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <div class="about-grid fade-in">
            <div class="about-image">🌺</div>
            <div>
                <span class="section-label">Our Philosophy</span>
                <h2 style="font-family: var(--font-display); font-size: 2rem; margin-bottom: 1rem;">Aloha Spirit First</h2>
                <p style="color: var(--color-text-muted); line-height: 1.8;">
                    We believe a casino resort should celebrate the land, the ocean, and the people who call Hawaii home.
                    Aloha Resort properties are designed so that gaming, accommodation, and wellness flow together
                    in harmony — like the rhythm of island life itself.
                </p>
                <p style="color: var(--color-text-muted); line-height: 1.8;">
                    From oceanfront suites in Waikiki to cliffside retreats on Kauai, every detail reflects the warmth
                    of Hawaiian hospitality and the natural beauty that surrounds our resorts.
                </p>
            </div>
        </div>

        <div class="values-grid fade-in">
            <div class="value-item">
                <h4>Island Roots</h4>
                <p>Deep respect for Hawaiian culture, land, and community at every property we operate.</p>
            </div>
            <div class="value-item">
                <h4>Tropical Luxury</h4>
                <p>Oceanfront suites, private lanais, and world-class amenities set against paradise backdrops.</p>
            </div>
            <div class="value-item">
                <h4>Responsible Play</h4>
                <p>Committed to safe, informed gaming with support resources available at all times.</p>
            </div>
        </div>

        <div class="content-card fade-in" style="margin-top: 3rem;">
            <h2>Accommodation</h2>
            <p>
                Our rooms and suites capture the essence of island living — natural materials, breezy open layouts,
                and stunning views of the Pacific. From deluxe oceanfront rooms to private villas with plunge pools,
                every stay is designed for tropical comfort and relaxation.
            </p>

            <h2>Gaming Experience</h2>
            <p>
                State-of-the-art casino floors feature thousands of slot machines, table games, poker rooms, and
                VIP salons — all in open, airy environments that reflect the relaxed pace of Hawaiian life.
                Outdoor terrace gaming and high-limit lounges offer unforgettable settings for every player.
            </p>

            <h2>Spa &amp; Wellness</h2>
            <p>
                Authentic Hawaiian wellness rituals including lomi lomi massage, volcanic stone therapy, and
                outdoor treatment pavilions. Balance the thrill of gaming with sunrise yoga, beach meditation,
                and traditional cultural experiences.
            </p>

            <h2>Responsible Gaming</h2>
            <p>
                Casino gaming is available exclusively to guests aged 21 and older. We promote responsible play
                through self-exclusion programs, spending limits, and trained support staff at every property.
            </p>
        </div>
    </div>
</section>
